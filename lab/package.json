{
  "name": "uhrturm-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Labor: Kampf-Engine, Bots und Simulation in TypeScript (Referenz für den Godot-Port)",
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "sim": "node sim/simulate.ts",
    "sim:smoke": "node sim/simulate.ts --smoke",
    "golden": "node tools/golden.ts",
    "viewer": "node sim/serve.ts",
    "sim:quick": "node sim/quick.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
